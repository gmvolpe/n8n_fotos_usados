    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// PickPatenteFolder (variante nativa): elige la carpeta de la patente. JS por el fuzzy de marca.\nconst res = ($('GraphSearchPatente').first().json.value) || [];\nconst P = $('Preparar').first().json;\nconst patente = P.patente;\nconst marca = P.marca;\n\nfunction norm(s) {\n  return (s || '').toString().normalize('NFD').replace(/[̀-ͯ]/g, '').toUpperCase().replace(/[^A-Z0-9]/g, '');\n}\nfunction lev(a, b) {\n  const m = a.length, n = b.length;\n  const d = Array.from({ length: m + 1 }, (_, i) => { const row = new Array(n + 1).fill(0); row[0] = i; return row; });\n  for (let j = 0; j <= n; j++) d[0][j] = j;\n  for (let i = 1; i <= m; i++) {\n    for (let j = 1; j <= n; j++) {\n      d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));\n    }\n  }\n  return d[m][n];\n}\nfunction fuzzy(a, b) {\n  a = norm(a); b = norm(b);\n  if (!a || !b) return false;\n  if (a === b || a.includes(b) || b.includes(a)) return true;\n  const dist = lev(a, b);\n  return dist <= Math.max(1, Math.floor(Math.max(a.length, b.length) * 0.3));\n}\n\nconst np = norm(patente);\nlet folders = res.filter(it => it.folder && norm(it.name).includes(np));\n\nif (marca) {\n  const conMarca = folders.filter(f => {\n    const path = (f.parentReference && f.parentReference.path) || '';\n    const seg = decodeURIComponent(path).split('/').pop();\n    return fuzzy(seg, marca) || fuzzy(path, marca);\n  });\n  if (conMarca.length) folders = conMarca;\n}\n\nconst chosen = folders[0];\nif (!chosen) {\n  return [{ json: { ok: false, accion: 'subir', patente, marca, markdown: '', archivos: [], mensaje: 'No se encontró carpeta con la patente' + (marca ? (' para la marca ' + marca) : '') } }];\n}\nreturn [{ json: { ok: true, folderId: chosen.id, folderName: chosen.name } }];\n"
      },
