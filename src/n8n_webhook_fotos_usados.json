        "jsCode": "// Filtra, del listado del FTP, los archivos que empiezan con la patente.\n// Siempre devuelve al menos 1 item (con hay:false) para que el flujo no se corte.\nconst P = $('Preparar').first().json;\nconst patente = P.patente;\nconst ftpPath = P.ftpPath || '/';\nconst base = ftpPath.endsWith('/') ? ftpPath : ftpPath + '/';\n\nconst entradas = $input.all().map(i => i.json).filter(Boolean);\n\nfunction esDirectorio(e) {\n  if (e.isDirectory === true) return true;\n  const t = e.type;\n  return t === 'd' || t === 2 || t === 'directory';\n}\n\nconst match = entradas.filter(e => e.name && !esDirectorio(e) && e.name.toUpperCase().startsWith(patente));\n\nif (!match.length) return [{ json: { hay: false } }];\n\nreturn match.map(e => ({ json: { hay: true, name: e.name, rutaBorrar: base + e.name } }));\n"
      },
