    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// FtpEliminar (variante nativa): borra del FTP los archivos de la patente. JS por FTPS (TLS explícito).\nconst ftpLib = require('basic-ftp');\n\nconst P = $('Preparar').item.json;\nconst patente = P.patente;\nconst ftp = { host: P.ftpHost, port: P.ftpPort, user: P.ftpUser, password: P.ftpPassword, secure: P.ftpSecure, dir: P.ftpDir };\n\nfunction norm(s) { return (s || '').toString().toUpperCase(); }\n\nconst client = new ftpLib.Client(30000);\nclient.ftp.verbose = false;\nconst eliminados = [];\n\ntry {\n  await client.access({ host: ftp.host, port: ftp.port, user: ftp.user, password: ftp.password, secure: ftp.secure, secureOptions: { rejectUnauthorized: false } });\n  await client.cd(ftp.dir);\n\n  const existentes = await client.list();\n  for (const e of existentes) {\n    if (e.isFile && norm(e.name).startsWith(patente)) {\n      try { await client.remove(e.name); eliminados.push(e.name); } catch (err) {}\n    }\n  }\n} finally {\n  client.close();\n}\n\nconst mensaje = eliminados.length\n  ? ('Se eliminaron ' + eliminados.length + ' archivo(s) de la patente ' + patente)\n  : 'No había fotos para la patente ' + patente;\n\nreturn [{ json: { ok: true, accion: 'eliminar', patente, total: eliminados.length, eliminados, mensaje } }];\n"
      },
      "id": "FtpEliminar",
      "name": "FtpEliminar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
