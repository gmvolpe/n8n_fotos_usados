    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// FtpSubir (variante nativa): descarga de WebKai y sube al FTP. JS por FTPS (TLS explícito).\nconst ftpLib = require('basic-ftp');\nconst { Readable } = require('stream');\n\nconst P = $('Preparar').item.json;\nconst patente = P.patente;\nconst marca = P.marca;\nconst publicBaseUrl = P.publicBaseUrl;\nconst ftp = { host: P.ftpHost, port: P.ftpPort, user: P.ftpUser, password: P.ftpPassword, secure: P.ftpSecure, dir: P.ftpDir };\n\nconst all = ($('GraphListWebKaiFiles').item.json.value) || [];\nconst files = all\n  .filter(f => f.file)\n  .sort((a, b) => a.name.localeCompare(b.name, 'es', { numeric: true, sensitivity: 'base' }));\n\nif (files.length === 0) {\n  return [{ json: { ok: false, accion: 'subir', patente, marca, total: 0, archivos: [], markdown: '', mensaje: 'La carpeta WebKai no tiene fotos' } }];\n}\n\nfunction norm(s) { return (s || '').toString().toUpperCase(); }\n\nconst client = new ftpLib.Client(30000);\nclient.ftp.verbose = false;\nconst archivos = [];\nconst markdownLines = [];\n\ntry {\n  await client.access({ host: ftp.host, port: ftp.port, user: ftp.user, password: ftp.password, secure: ftp.secure, secureOptions: { rejectUnauthorized: false } });\n  await client.ensureDir(ftp.dir);\n  await client.cd(ftp.dir);\n\n  const existentes = await client.list();\n  for (const e of existentes) {\n    if (e.isFile && norm(e.name).startsWith(patente)) {\n      try { await client.remove(e.name); } catch (err) {}\n    }\n  }\n\n  let i = 0;\n  for (const f of files) {\n    i++;\n    const ext = (f.name.includes('.') ? f.name.split('.').pop() : 'jpg').toLowerCase();\n    const destName = patente + '_' + i + '.' + ext;\n    const url = f['@microsoft.graph.downloadUrl'] || f['@content.downloadUrl'];\n    if (!url) continue;\n    const data = await this.helpers.httpRequest({ url, encoding: 'arraybuffer' });\n    const buf = Buffer.isBuffer(data) ? data : Buffer.from(data);\n    await client.uploadFrom(Readable.from(buf), destName);\n    archivos.push(destName);\n    markdownLines.push('![' + patente + '_' + i + '](' + publicBaseUrl + destName + ')');\n  }\n} finally {\n  client.close();\n}\n\nif (archivos.length === 0) {\n  return [{ json: { ok: false, accion: 'subir', patente, marca, total: 0, archivos: [], markdown: '', mensaje: 'No se pudo subir ninguna foto' } }];\n}\n\nreturn [{ json: { ok: true, accion: 'subir', patente, marca, total: archivos.length, archivos, markdown: markdownLines.join('\\n') } }];\n"
      },
      "id": "FtpSubir",
      "name": "FtpSubir",
      "type": "n8n-nodes-base.code",
