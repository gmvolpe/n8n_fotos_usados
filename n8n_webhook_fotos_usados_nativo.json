    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// FindWebKai (variante nativa): ubica la subcarpeta WebKai. JS por la respuesta limpia de \"no encontrado\".\nconst children = ($('GraphListPatenteChildren').item.json.value) || [];\nconst P = $('Preparar').item.json;\nconst target = (P.webkaiName || 'WebKai').toLowerCase();\n\nconst wk = children.find(c => c.folder && (c.name || '').trim().toLowerCase() === target)\n  || children.find(c => c.folder && (c.name || '').trim().toLowerCase().includes(target));\n\nif (!wk) {\n  return [{ json: { ok: false, accion: 'subir', patente: P.patente, marca: P.marca, markdown: '', archivos: [], mensaje: 'No se encontró la carpeta ' + P.webkaiName } }];\n}\nreturn [{ json: { ok: true, webkaiId: wk.id } }];\n"
      },
